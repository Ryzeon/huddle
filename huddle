#!/usr/bin/env bash
#
#   huddle join <sala> <@alias> --hub wss://…
#   huddle daemon
#   huddle ask @alguien "pregunta"
#   huddle who | huddle status
#
set -euo pipefail

# Se resuelven los enlaces simbólicos: instalado, lo que está en el PATH es un
# enlace a este archivo, y sin esto el `cd` acabaría en el directorio del
# enlace en vez de en el del repositorio.
origen="${BASH_SOURCE[0]}"
while [ -L "$origen" ]; do
  destino="$(readlink "$origen")"
  case "$destino" in
    /*) origen="$destino" ;;
    *)  origen="$(cd -P "$(dirname "$origen")" && pwd)/$destino" ;;
  esac
done

cd "$(cd -P "$(dirname "$origen")" && pwd)"
exec npx --yes tsx packages/agent/src/adapters/inbound/cli.ts "$@"
