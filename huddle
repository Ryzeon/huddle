#!/usr/bin/env bash
# Envoltorio para no escribir `npx tsx packages/agent/src/...` cada vez.
#
#   ./huddle join <sala> <@alias> --hub ws://IP:8787 --token <t>
#   ./huddle daemon
#   ./huddle ask @alguien "pregunta"
#   ./huddle who | ./huddle status
#
# Para registrarlo en Claude Code hace falta la ruta absoluta:
#   claude mcp add huddle -- /ruta/a/huddle/huddle mcp
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"
exec npx --yes tsx packages/agent/src/adapters/inbound/cli.ts "$@"
